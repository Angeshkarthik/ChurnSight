# Virtual Environments
.venv/
venv/
env/
ENV/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Environment Variables & Secrets
.env
*.env

# Data Files (Keep directory structure via .gitkeep, ignore data dumps)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Serialized Model Artifacts (Binaries shouldn't be tracked in Git)
models/*
!models/.gitkeep

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo

# OS Specific Files
Thumbs.db
Desktop.ini
.DS_Store
