# Virtual Environments
.venv/
venv/
env/
ENV/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# Environment Variables & Local Configuration
.env
*.env
.env.*
!.env.example

# Frontend Dependencies & Build Output
node_modules/
dist/
dist-ssr/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Data Files (Keep directory structure via .gitkeep, ignore raw & processed dumps)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Serialized Model Artifacts (Ignore arbitrary model dumps; track champion pipeline & metadata)
models/*
!models/.gitkeep
!models/churn_model.joblib
!models/model_metadata.json

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo

# OS Specific Files
Thumbs.db
Desktop.ini
.DS_Store
