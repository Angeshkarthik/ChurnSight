# =============================================================================
# ChurnSight — Environment Configuration Template
# Copy to .env or configure in your deployment environment.
# =============================================================================

# FastAPI Backend Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Allowed CORS Origins (comma-separated list for local frontend dev origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional Model Artifact Overrides (defaults to local repository paths)
# CHURN_MODEL_PATH=models/churn_model.joblib
# CHURN_METADATA_PATH=models/model_metadata.json

# React Frontend Configuration (Vite)
# Specifies the backend endpoint URL consumed by the React application
VITE_API_BASE_URL=http://127.0.0.1:8000
